# ==============================================================================
# MASTER PANEL BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Port
APP_PORT=8080

# Security Keys
JWT_SECRET=your_super_secret_jwt_key_here
WORKER_API_SECRET=your_cloudflare_worker_and_apk_secret_here

# Admin PostgreSQL Database (engine-auth / backoffice)
# Database terpusat untuk autentikasi admin, master agen, dan metadata koneksi tenant.
ADMIN_DB_HOST=62.72.46.195
ADMIN_DB_PORT=2022
ADMIN_DB_USER=postgres
ADMIN_DB_PASS=postgres
ADMIN_DB_NAME=engine-auth
ADMIN_DB_SSLMODE=disable

# Redis Cache (Winlose Reports & Fast Lookup)
# Otomatis fallback ke Memory Cache jika Redis tidak aktif/tidak diinstal.
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Default Fallback for win-backend-api
DEFAULT_AGENT_API_URL=http://127.0.0.1:5050
DEFAULT_AGENT_SECRET=AbCdEfGh

# SQLite Local Database & Invisible GOD Admin
# Akun GOD Admin ini tersembunyi total (invisible) dari semua user lain di panel.
SQLITE_DB_PATH=data/master_panel.db
INITIAL_SUPERADMIN_NAME="GOD Administrator"
INITIAL_SUPERADMIN_EMAIL=superadmin@masterpanel.local
INITIAL_SUPERADMIN_PASSWORD=admin123456
GOD_ROLE_NAME="GOD Admin"

